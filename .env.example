# Провайдер LLM: mock | openrouter | local
LLM_PROVIDER=mock

# OpenRouter (боевой режим)
OPENROUTER_API_KEY=
LLM_MODEL=qwen/qwen3-235b-a22b-2507
LLM_VISION_MODEL=qwen/qwen3-vl-235b-a22b-instruct

# Необязательный локальный сервер: используется только при LLM_PROVIDER=local
LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL=qwen3

# Ограничители
MAX_AGENT_STEPS=8
REQUEST_TIMEOUT_S=60
PRICE_LIMIT_RUB=3.0
USD_RUB=95.0

# Индекс
# Самостоятельный расчётчик использует локальный текстовый поиск BM25.
INDEX_BACKEND=bm25
INDEX_DIR=data/index
METHODICS_DIR=data/methodics

# База текста PDF и поиск команды
RETRIEVAL_BACKEND=team
TEAM_INDEX_DIR=data/team_index
TEAM_PARSED_DIR=data/team_parsed
